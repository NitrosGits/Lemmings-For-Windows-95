LEMMINGS ICON "res/lemmings.ico"

LEMMINGS MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Give Up", 278
        MENUITEM "&Restart This Level", 280
        MENUITEM "&Action Replay This Level", 40005
        MENUITEM "&Choose Level", 275
        MENUITEM "Cheat This Level", 40008
        MENUITEM SEPARATOR
        MENUITEM "Set Options...", 375
        MENUITEM SEPARATOR
        MENUITEM "E&xit", 277
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents", 314
        MENUITEM "&Search for Help On...", 316
        MENUITEM "&How to Use Help", 318
        MENUITEM SEPARATOR
        MENUITEM "&About Lemmings...", 320
    END
END

FRONTEND MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Next Level", 279
        MENUITEM "&Choose Level", 275
        MENUITEM SEPARATOR
        MENUITEM "Select Player...", 40007
        MENUITEM "Set Options...", 375
        MENUITEM SEPARATOR
        MENUITEM "E&xit", 277
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents", 314
        MENUITEM "&Search for Help On...", 316
        MENUITEM "&How to Use Help", 318
        MENUITEM SEPARATOR
        MENUITEM "&About Lemmings...", 320
    END
END

ENDSCREEN MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Next Level", 279
        MENUITEM "&Choose Level", 275
        MENUITEM "Action Replay of Last Level", 391
        MENUITEM SEPARATOR
        MENUITEM "Select Player...", 40007
        MENUITEM "Set Options...", 375
        MENUITEM SEPARATOR
        MENUITEM "E&xit", 277
    END
    POPUP "&Help"
